class Student {
    String name;
    int age;

    Student() {
        name = "Sannihitha";
        age = 21;
    }

    void display() {
        System.out.println(name);
        System.out.println(age);
    }

    public static void main(String[] args) {
        Student s = new Student();
        s.display();
    }
}
